# Gemini API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier quota is per model; pick the one with the highest daily limit
GEMINI_MODEL=gemini-3.5-flash-lite

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Per-IP rate limit on POST /runs
RATE_LIMIT_RUNS_PER_DAY=5

# Hard caps
MAX_RETRIES_PER_SUBTASK=3
MAX_STEPS_PER_RUN=15
MAX_TOKENS_PER_RUN=100000

# Sandbox resource limits
SANDBOX_CPUS=1
SANDBOX_MEMORY=512m
SANDBOX_TIMEOUT_SECONDS=10

# Owner access (step 4.4): requests with "Authorization: Bearer <OWNER_TOKEN>"
# skip the public rate limit. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable owner access entirely.
OWNER_TOKEN=

# Where the CLI sends requests
AGENT_API_URL=http://127.0.0.1:8000
